# =============================================================================
# CYSCOM ALUMNI MEETUP — Environment Variables Template
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env.local` (never commit `.env.local` to git!)
#      cp .env.local.example .env.local
# 2. Fill in the values from YOUR Supabase project:
#      Supabase Dashboard -> Project Settings -> API
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE PROJECT URL
# Where to find it: Supabase Dashboard -> Project Settings -> API -> "Project URL"
# Example: https://abcdefghijklm.supabase.co
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# -----------------------------------------------------------------------------
# SUPABASE ANON (PUBLIC) KEY
# Where to find it: Supabase Dashboard -> Project Settings -> API ->
#                   "anon public" key under API Keys.
# This key is safe to expose to the browser because Row Level Security (RLS)
# policies protect your data server-side. NEVER put the `service_role` key here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# -----------------------------------------------------------------------------
# SITE URL
# The public URL of this app. Used to build the OAuth redirect back into the app.
# Local dev:  http://localhost:3000
# Production: https://your-app.vercel.app
# Must EXACTLY match one of the "Redirect URLs" configured in Google Cloud Console.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# GOOGLE OAUTH CREDENTIALS — NOT stored here!
# -----------------------------------------------------------------------------
# The Google OAuth Client ID and Client Secret are configured inside the
# SUPABASE DASHBOARD (not in this Next.js app):
#
#   Supabase Dashboard -> Authentication -> Providers -> Google -> Enable
#     • Client ID     : from Google Cloud Console -> APIs & Services -> Credentials
#     • Client secret : from Google Cloud Console -> APIs & Services -> Credentials
#     • Redirect URL to authorize in Google:
#         https://<YOUR-SUPABASE-PROJECT-REF>.supabase.co/auth/v1/callback
#
# See README.md for the full step-by-step setup instructions.
# =============================================================================
